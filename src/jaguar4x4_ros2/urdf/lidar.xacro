<?xml version="1.0"?>
<robot name="jaguar_robot" xmlns:xacro="http://ros.org/wiki/xacro">
`
    <xacro:property name="wheel_base_offset" value="0.03"/>
    <xacro:property name="base_x_size" value="${0.615-2*wheel_base_offset}"/>

    <xacro:property name="laser_x" value="${base_x_size/2-0.0725}"/>
    <xacro:property name="laser_y" value="0"/>
    <xacro:property name="laser_z" value="${0.255+0.05}"/>
    <!-- <xacro:property name="laser_z" value="${0.255+0.05}"/> -->

    <xacro:property name="laser_x_size" value="0.065"/>
    <xacro:property name="laser_y_size" value="0.09"/>
    <xacro:property name="laser_z_size" value="0.1"/>

    <link name="laser">

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <box size="${laser_x_size} ${laser_y_size} ${laser_z_size}"/>
        </geometry>
    </collision>


    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${laser_x_size} ${laser_y_size} ${laser_z_size}"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 0.8"/>
        </material>
    </visual>
    </link>


    <joint name="laser_joint" type="fixed">
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser"/>
    </joint>

    <gazebo reference="laser">
    <sensor name="jaguar_lidar" type="ray">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>

        <ray>
        <scan>
            <horizontal>
            <samples>40</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
            </horizontal>
        </scan>

        <range>
            <min>0.35</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
        </range>
        </ray>

        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
            <remapping>~/out:=scan</remapping>
        </ros>
        <frame_name>laser</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
        </plugin>

    </sensor>
    </gazebo>
</robot>