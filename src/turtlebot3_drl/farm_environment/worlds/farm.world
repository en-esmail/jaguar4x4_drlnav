<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <mesh>
      <uri>model://farm/meshes/agriculture_world.dae</uri>
      <scale>10 10 10</scale>
    </mesh>


    <!-- A global light source -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.5 -1.0</direction>
    </light>

    <gravity>0 0 -9.8</gravity>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Static environment mesh -->
    <!-- Farm terrain mesh -->
    <model name="farm_mesh">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://farm/meshes/agriculture_world.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://farm/meshes/agriculture_world.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>


    <!-- Populations of bushes -->
    <population name="bush_population3">
      <model name="bush3">
        <include>
          <static>true</static>
          <uri>model://bush</uri>
        </include>
      </model>
      <pose>5 -1 0.1 0 0 0</pose>
      <box><size>10 0.6 0.6</size></box>
      <model_count>15</model_count>
      <distribution><type>linear-x</type></distribution>
    </population>

    <population name="bush_population4">
      <model name="bush4">
        <include>
          <static>true</static>
          <uri>model://bush</uri>
        </include>
      </model>
      <pose>5 1 0.1 0 0 0</pose>
      <box><size>10 0.6 0.6</size></box>
      <model_count>15</model_count>
      <distribution><type>linear-x</type></distribution>
    </population>

    <population name="bush_population5">
      <model name="bush5">
        <include>
          <static>true</static>
          <uri>model://bush</uri>
        </include>
      </model>
      <pose>5 3 0.1 0 0 0</pose>
      <box><size>10 0.6 0.6</size></box>
      <model_count>15</model_count>
      <distribution><type>linear-x</type></distribution>
    </population>

    <population name="bush_population6">
      <model name="bush6">
        <include>
          <static>true</static>
          <uri>model://bush</uri>
        </include>
      </model>
      <pose>5 5 0.1 0 0 0</pose>
      <box><size>10 0.6 0.6</size></box>
      <model_count>15</model_count>
      <distribution><type>linear-x</type></distribution>
    </population>

    <population name="bush_population7">
      <model name="bush7">
        <include>
          <static>true</static>
          <uri>model://bush</uri>
        </include>
      </model>
      <pose>5 7 0.1 0 0 0</pose>
      <box><size>10 0.6 0.6</size></box>
      <model_count>15</model_count>
      <distribution><type>linear-x</type></distribution>
    </population>

    <!-- Shacks -->
    <model name='shack_0'>
      <static>true</static>
      <link name='link_shack_0'>
        <pose>11.5 -3.5 -0.01 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='shack_1'>
      <static>true</static>
      <link name='link_shack_1'>
        <pose>12 8 0.04 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='shack_2'>
      <static>true</static>
      <link name='link_shack_2'>
        <pose>-4 -3 0.04 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='shack_3'>
      <static>true</static>
      <link name='link_shack_3'>
        <pose>-3 8 0.04 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://shack/meshes/shack.dae</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ROS factory plugin -->
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

  </world>
</sdf>
