<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 14.0 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name='arena_structure'>
      <static>1</static>
      <link name='walls'>
        
        <collision name='wall_north_col'>
          <pose>0 5 0.5 0 0 0</pose>
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='wall_north_vis'>
          <pose>0 5 0.5 0 0 0</pose>
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='wall_south_col'>
          <pose>0 -5 0.5 0 0 0</pose>
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='wall_south_vis'>
          <pose>0 -5 0.5 0 0 0</pose>
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='wall_west_col'>
          <pose>-5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
        </collision>
        <visual name='wall_west_vis'>
          <pose>-5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='wall_east_col'>
          <pose>5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
        </collision>
        <visual name='wall_east_vis'>
          <pose>5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='inner_wall_1_col'>
          <pose>-2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
        </collision>
        <visual name='inner_wall_1_vis'>
          <pose>-2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='inner_wall_2_col'>
          <pose>2.5 -2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
        </collision>
        <visual name='inner_wall_2_vis'>
          <pose>2.5 -2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='inner_wall_3_col'>
          <pose>2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>2.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='inner_wall_3_vis'>
          <pose>2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>2.0 0.15 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <collision name='inner_wall_4_col'>
          <pose>-2.5 -2.5 0.5 0 0 0</pose>
          <geometry><box><size>2.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='inner_wall_4_vis'>
          <pose>-2.5 -2.5 0.5 0 0 0</pose>
          <geometry><box><size>2.0 0.15 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <model name="turtlebot3_drl_obstacle1">
      <plugin name="obstaclelarge1" filename="libobstacle7.so"/>
      <include>
        <pose>3.5 3.5 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle1</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle2">
      <plugin name="obstaclelarge2" filename="libobstacle8.so"/>
      <include>
        <pose>-3.5 -3.5 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle2</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle3">
      <plugin name="obstaclelarge3" filename="libobstacle9.so"/>
      <include>
        <pose>3.5 -3.5 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle3</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle4">
      <plugin name="obstaclelarge4" filename="libobstacle10.so"/>
      <include>
        <pose>-3.5 3.5 0 0 0 0</pose>
